rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Same check as firestore.rules: any approved admin. Reads admins/{uid} from Firestore (cross-service rules).
    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role != 'pending';
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function under(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    // --- Admin-managed content ---

    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null || (under(50) && isImage()));
    }

    match /event-images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null || (under(50) && isImage()));
    }

    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null
        || (under(50) && (isImage() || request.resource.contentType.matches('video/.*'))));
    }

    match /resources/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null
        || (under(50) && (isImage() || request.resource.contentType == 'application/pdf')));
    }

    match /resource-thumbnails/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null || (under(50) && isImage()));
    }

    match /profiles/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null || (under(5) && isImage()));
    }

    match /team_profiles/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null || (under(5) && isImage()));
    }

    // --- Per-user avatars ---
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && (request.resource == null || (under(5) && isImage()));
    }

    // Everything else: readable for existing URLs, never writable.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
