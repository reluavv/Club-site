rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // --- Path-Specific Rules ---

    // Event posters and assets — any authenticated user can upload (admins manage events)
    // TODO (S-01): Restrict writes to admin-only via Custom Claims (request.auth.token.admin == true)
    // Currently any authenticated user can upload/delete. Requires server-side Custom Claims setup.
    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated()
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated();
    }
    match /event-images/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated()
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated();
    }

    // Gallery images and videos — authenticated users can upload
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated()
                   && request.resource.size < 50 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*'));
      allow delete: if isAuthenticated();
    }

    // Resource files (PDFs, documents, images)
    match /resources/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated()
                   && request.resource.size < 50 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
      allow delete: if isAuthenticated();
    }
    match /resource-thumbnails/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated()
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated();
    }

    // User avatars — users can only manage files in their own folder
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated()
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }
    
    match /profiles/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated();
    }
    
    match /team_profiles/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated();
    }

    // Default: deny writes to any paths not explicitly matched above
    // Read is still public for backward compatibility with any existing URLs
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }
  }
}
