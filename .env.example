# Copy this file to .env.local and fill in the values.

# Firebase web app config (Firebase Console > Project Settings > General > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only. Base64-encoded service account JSON for the Firebase Admin SDK.
# Leave empty on Cloud Run, which uses the service's default credentials.
FIREBASE_ADMIN_KEY=

# Firestore database ID. The project has two databases: (default) and default-clone.
# Use default-clone for local development and testing.
# Production Cloud Run uses (default) — see cloudbuild.yaml substitutions.
#
# IMPORTANT: NEXT_PUBLIC_* variables are embedded into the browser bundle by
# `next build`. They are NOT read at runtime from the server environment.
# A missing value here causes runtime failures in the browser (e.g. "Firebase
# fetch failed (Events): NEXT_PUBLIC_FIRESTORE_DATABASE_ID is required").
# The Dockerfile and cloudbuild.yaml both validate this at build time.
#
# Client-side (embedded at build time, see Dockerfile builder stage).
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=(default)
# Server-side (Firebase Admin SDK, read at request time).
FIRESTORE_DATABASE_ID=(default)

# Backblaze B2 object storage for the event gallery (src/lib/objectStorage.ts).
# Create a PRIVATE bucket and an application key limited to it; media is
# delivered through /api/gallery/media (server-side), never from a public URL.
# B2_S3_ENDPOINT is the S3 endpoint from the bucket's details, e.g.
# https://s3.us-west-004.backblazeb2.com — copy it, do not guess it.
# Omit all five and the gallery upload UIs fail closed with an actionable
# list of the missing variables — there is no silent fallback.
B2_S3_ENDPOINT=
B2_REGION=
B2_BUCKET_NAME=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=

# Gmail account and app password used by /api/send-email and by the birthday
# mailer (/api/birthday-send and the daily /api/cron/birthdays run).
EMAIL_USER=
EMAIL_PASS=

# Club time zone, used to decide which calendar day counts as "today" for
# birthday mail. Defaults to Asia/Kolkata when unset.
CLUB_TIMEZONE=Asia/Kolkata

# Shared secret that lets the daily scheduler call /api/cron/birthdays without
# a user session:  openssl rand -hex 32
# Leave empty to disable scheduled mail (the route answers 503).
CRON_SECRET=

# Optional. Only when Google Analytics is linked to the Firebase web app.
# Leave empty to skip Analytics entirely (no ga cookies, no gtag request).
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
