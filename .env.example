# Copy this file to .env.local and fill in the values.

# Firebase web app config (Firebase Console > Project Settings > General > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only. Base64-encoded service account JSON for the Firebase Admin SDK.
# Leave empty on Cloud Run, which uses the service's default credentials.
FIREBASE_ADMIN_KEY=

# Firestore database ID. The project has two databases: (default) and default-clone.
# Use default-clone for local development and testing. Explicitly required in production.# NEXT_PUBLIC_FIRESTORE_DATABASE_ID=default-clone
FIRESTORE_DATABASE_ID=default-clone

# Backblaze B2 object storage for the event gallery (src/lib/objectStorage.ts).
# Create a PRIVATE bucket and an application key limited to it; media is
# delivered through /api/gallery/media (server-side), never from a public URL.
# B2_S3_ENDPOINT is the S3 endpoint from the bucket's details, e.g.
# https://s3.us-west-004.backblazeb2.com — copy it, do not guess it.
# Omit all five to keep gallery uploads on legacy Firebase Storage.
B2_S3_ENDPOINT=
B2_REGION=
B2_BUCKET_NAME=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=

# Legacy Cloudflare R2 (src/lib/objectStorage.ts), configured only while old
# gallery objects still live in R2. When B2_* above is set, these are ignored
# for new uploads; the configured provider fetches/deletes by key. Remove them
# after running the verified migration (see docs/gallery-migration.md).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Gmail account and app password used by /api/send-email
EMAIL_USER=
EMAIL_PASS=

# Optional. Only when Google Analytics is linked to the Firebase web app.
# Leave empty to skip Analytics entirely (no ga cookies, no gtag request).
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
