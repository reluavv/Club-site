# Copy this file to .env.local and fill in the values.

# Firebase web app config (Firebase Console > Project Settings > General > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only. Base64-encoded service account JSON for the Firebase Admin SDK.
# Leave empty on Cloud Run, which uses the service's default credentials.
FIREBASE_ADMIN_KEY=

# Cloudflare R2 object storage for the event gallery (src/lib/r2.ts).
# Create a dedicated bucket and a least-privilege API token scoped to it.
# R2_PUBLIC_BASE_URL is the delivery base: a custom domain or the bucket's
# managed r2.dev domain. Omit all five to keep gallery uploads on Firebase Storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Gmail account and app password used by /api/send-email
EMAIL_USER=
EMAIL_PASS=

# Optional. Only when Google Analytics is linked to the Firebase web app.
# Leave empty to skip Analytics entirely (no ga cookies, no gtag request).
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
