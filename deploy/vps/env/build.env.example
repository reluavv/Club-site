# Build-time environment (PUBLIC Firebase web-app config only).
# Copy to /opt/relu-website/repo/.env.production.local on the VPS and fill in
# with the LIVE project (relu-480416) values from the Firebase console.
#
# These six values are embedded in every page's JS by `next build`, so they
# must exist in the shell when build-and-deploy.sh runs. They are public by
# design (Firebase web keys are not secrets) but still stay out of git: the
# filename matches the repo's `.env*.local` ignore rule.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional. Only when Google Analytics is linked to the Firebase web app.
# Leave empty to skip Analytics (Firebase Analytics + consent banner handles
# the skip gracefully).
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
