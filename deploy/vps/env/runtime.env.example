# Runtime secrets for /etc/relu-website/runtime.env
#
# HOW TO CREATE ON THE VPS (never put these in git, chat, or the build dir):
#   sudo install -d -m 700 /etc/relu-website
#   sudo install -m 600 /dev/stdin /etc/relu-website/runtime.env <<'EOF'
#   <contents below, filled in>
#   EOF
#   sudo chown root:root /etc/relu-website/runtime.env
#
# SYSTEMD READS THIS FILE AS ROOT before dropping to the `relu` user.
# Rules: one KEY=VALUE per line, no quotes, no spaces around `=`,
# no line breaks inside a value.

# FIREBASE_ADMIN_KEY: the service-account JSON, base64-encoded as ONE line.
# Generate offline on your own machine (never run base64 on the bare VPS
# terminal unless you have cleared history, and never echo the JSON):
#   base64 -w0 path/to/service-account.json   # Linux / Git Bash
#   base64 -i service-account.json | tr -d '\n'   # macOS
# Sanity-check on the VPS without printing the payload:
#   echo "$FIREBASE_ADMIN_KEY" | base64 -d >/dev/null && echo decodes-ok
# Keys can be revoked/rotated from the Firebase console (Service accounts);
# rotate by re-encoding and rewriting this file, then restart the service.
FIREBASE_ADMIN_KEY=

# Gmail account + app password for /api/send-email (Nodemailer).
# The app password comes from the Google account itself; see
# https://myaccount.google.com/apppasswords.
EMAIL_USER=
EMAIL_PASS=
